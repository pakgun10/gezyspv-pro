# Salin ke .env dan isi. JANGAN commit .env.
# Database MariaDB (lihat README bagian "Menyiapkan database").
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gezyspv
DB_PASSWORD=isi-kata-sandi-db-di-sini
DB_NAME=gezyspv_dev
# Database khusus bun test (dibuat oleh scripts/setup-db.ts).
TEST_DB_NAME=gezyspv_test
# Port aplikasi.
PORT=3000
# Folder data (foto bukti, backup). Default ./data
DATA_DIR=./data
# Set true bila aplikasi di balik HTTPS (cookie Secure).
SESSION_COOKIE_SECURE=false
# Kata sandi admin dev (username: admin). Lihat README — akun ini
# wajib ganti kata sandi saat login pertama (must_change_password=1).
# Kosongkan untuk memakai kata sandi dev default dari README.
ADMIN_DEV_PASSWORD=
